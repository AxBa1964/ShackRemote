<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ShackRemote</AssemblyName>
    <RootNamespace>ShackRemote</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\shackremote.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Dunkler Modus von WinForms (Application.SetColorMode) ist in .NET 10 noch als experimentell markiert -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bindungen für FFmpeg 9.0 (avcodec-63 …); die DLLs selbst holt tools\get-ffmpeg.ps1 -->
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <!-- Windows-Dienst (ServiceBase, ServiceController) -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <!-- Ton: WASAPI-Aufnahme (Loopback/Aufnahmegerät) und -Wiedergabe; bewusst die bewährte 2.2.1 (3.x hat neue Schnittstellen) -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Startbild (optional): Assets\intro.png wird in die Exe eingebettet -->
    <EmbeddedResource Include="Assets\intro.png" Condition="Exists('Assets\intro.png')" LogicalName="ShackRemote.Assets.intro.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg-DLLs aus <Repo>\ffmpeg\bin neben die exe kopieren (Build und Publish) -->
    <None Include="..\..\ffmpeg\bin\*.dll" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
